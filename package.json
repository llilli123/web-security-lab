{
  "name": "web-security-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "20 laboratorios educativos de seguridad web para Cloudflare Pages",
  "scripts": {
    "dev": "wrangler pages dev public --binding LAB_MODE=local",
    "dev:public": "wrangler pages dev public",
    "db:local": "wrangler d1 execute web-security-lab --local --file=db/schema.sql",
    "db:remote": "wrangler d1 execute web-security-lab --remote --file=db/schema.sql",
    "deploy": "wrangler pages deploy public --project-name=web-security-lab",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
